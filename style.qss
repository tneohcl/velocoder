/* TITAN-i Transcoder theme. Every color is a placeholder token (a dollar
   sign followed by a name, e.g. BG_WINDOW), substituted by
   _load_stylesheet() in main.py against themes.py's DARK/LIGHT palettes
   before this ever reaches setStyleSheet() -- same mechanism the asset
   path placeholder already used, extended to colors. Layout/spacing
   values (padding, radius, sizes) are NOT tokenized -- they're
   theme-independent by design, only color should ever differ between
   Dark/Light/System.

   Loaded once in main() via app.setStyleSheet() -- see that function for
   why app.setStyle("Fusion") has to be called first (native styles like
   Breeze ignore several of the subcontrols this file relies on, e.g. the
   slider groove/handle and the combobox popup). */

/* Transparent by default, not $BG_WINDOW -- this used to paint every
   plain QWidget (QLabel, QCheckBox, QSlider, and every bare QWidget()
   used purely as a layout container, e.g. the one holding Effective
   Command's text box + Copy button) opaquely in $BG_WINDOW regardless of
   what it was actually nested inside, usually a QGroupBox/QTabWidget pane
   at $BG_PANEL instead. $BG_WINDOW/$BG_PANEL are close enough in Dark
   (#1a1d23/#21252c) that this was invisible there; Light's aren't
   (#eef0f3/#ffffff), and it showed up as labels, checkboxes, and
   button-adjacent empty space all sitting in a visibly mismatched grey
   box -- confirmed by screenshot, not assumed, and confirmed latent since
   before Light theme existed. Every widget that DOES need an opaque
   background of its own (QMainWindow/QSplitter below, QGroupBox,
   QPushButton, the form fields, QTreeWidget, ...) already has its own
   more-specific rule, which still wins regardless of this default. */
QWidget {
    background-color: transparent;
    color: $TEXT_PRIMARY;
    font-size: 10pt;
}

QMainWindow, QSplitter {
    background-color: $BG_WINDOW;
}

/* margin-top used to be 14px, just about exactly the title text's own
   rendered height at 10pt bold -- the title sat straddling the border
   line instead of clearing it, the classic "native GroupBox" look (a
   rounded corner visibly cutting through the title text) that reads as
   dated once the rest of the app is flat and themed. The extra headroom
   here puts the title fully above the border instead, like a heading over
   a card rather than a legend embedded in the box's own edge. */
QGroupBox {
    background-color: $BG_PANEL;
    border: 1px solid $BORDER;
    border-radius: 8px;
    margin-top: 22px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    /* left: 0, not 12px -- 12px plus this padding's own 6px left a ~18px
       gap before the title text actually started, well past what the
       6px padding everything else in this app uses would suggest.
       top: 0, not a negative offset -- a negative top was tried to nudge
       the title further up within the margin area, but it pushed the
       text above the QGroupBox's own bounding box entirely, clipping it
       (confirmed by screenshot) rather than just tightening the gap to
       the border below. margin-top above already reserves enough room
       that no offset is needed at all. */
    left: 0px;
    padding: 0 6px;
    color: $ACCENT;
}

/* Effective Command / Log -- an ordinary checkable QGroupBox otherwise
   identical to every other section (same title subcontrol, same border,
   same everything -- deliberately not styled differently, so collapsing a
   section doesn't also make its title look unlike Encoding/Format/Audio
   Settings). Only the checkbox glyph itself is zeroed out here; the
   trailing arrow that replaces it lives in the title *text*
   (main.py's _make_collapsible_group), and the whole title bar stays
   clickable regardless of the glyph's rendered size -- confirmed
   empirically, not just assumed, since that's the entire premise this
   relies on. */
QGroupBox#collapsibleGroup::indicator {
    width: 0px;
    height: 0px;
}

QTabWidget::pane {
    border: 1px solid $BORDER;
    border-radius: 8px;
    top: -1px;
    background: $BG_PANEL;
}

/* Four iterations to get here. A plain underline (no fill, no border)
   read as floating clickable text, not an actual tab shape. A filled
   $BG_PANEL selected-tab plus a full $BORDER box read as too heavy a
   highlight next to unselected tabs' plain outline. Uniform $BG_WINDOW
   fill on both states (an outline-only middle ground) still wasn't right
   either -- the selected tab is supposed to represent the *content pane
   right below it*, and that pane is $BG_PANEL, not $BG_WINDOW, so a
   selected tab colored like the window instead of its own content still
   didn't visually belong to what it was selecting. $BG_PANEL fill with
   the border color *also* set to $BG_PANEL (next attempt) went a step
   too far -- border-bottom: none below is what actually produces the
   seamless-with-content look on the one edge that should have it; setting
   border-color killed the color on all four sides, not just the bottom
   one that needed it, leaving the selected tab with no visible outline of
   its own at all. Landed on: border-bottom stays none (seamless into the
   pane), but the remaining three sides keep a real, visible color --
   $ACCENT for the selected tab specifically, marking it "active" the same
   way this app already uses accent color elsewhere, $BORDER for
   unselected so the tab shape reads even before it's selected. */
QTabBar::tab {
    background: $BG_WINDOW;
    color: $TEXT_SECONDARY;
    padding: 6px 18px;
    margin-right: 2px;
    margin-top: 2px;
    border: 1px solid $BORDER;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background: $BG_PANEL;
    color: $TEXT_PRIMARY;
    border-color: $ACCENT;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    color: $TEXT_TERTIARY;
    border-color: $BORDER_HOVER;
}

QPushButton {
    background-color: $BG_CONTROL;
    border: 1px solid $BORDER_STRONG;
    border-radius: 6px;
    padding: 6px 14px;
    color: $TEXT_PRIMARY;
}

QPushButton:hover {
    background-color: $BG_CONTROL_HOVER;
    border-color: $ACCENT;
}

QPushButton:pressed {
    background-color: $BG_CONTROL_PRESSED;
}

QPushButton:disabled {
    color: $TEXT_DISABLED;
    border-color: $BG_CONTROL;
    background-color: $BG_DISABLED;
}

/* Start/Stop get object names in main.py so they read as the primary and
   destructive actions instead of blending into every other button. */
QPushButton#startButton {
    background-color: $ACCENT;
    border: none;
    color: $TEXT_ON_ACCENT;
    font-weight: 600;
}

QPushButton#startButton:hover { background-color: $ACCENT_HOVER; }
QPushButton#startButton:pressed { background-color: $ACCENT_PRESSED; }
QPushButton#startButton:disabled { background-color: $BG_ACCENT_DISABLED; color: $TEXT_ACCENT_DISABLED; }

QPushButton#stopButton:enabled {
    border-color: $DESTRUCTIVE;
    color: $DESTRUCTIVE;
}

QPushButton#stopButton:enabled:hover {
    background-color: $BG_DESTRUCTIVE_HOVER;
}

/* Rate Control's Quality / File Size / Advanced row -- three adjacent
   checkable QPushButtons standing in for a segmented control (Qt has no
   native one). Corners only round on the two outer edges, and the shared
   inner edges drop their own border so two adjacent 1px borders don't
   double up into a visibly thicker seam between buttons. */
QPushButton#segLeft, QPushButton#segMid, QPushButton#segRight {
    border-radius: 0;
}

QPushButton#segLeft {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

QPushButton#segMid, QPushButton#segRight {
    border-left: none;
}

QPushButton#segRight {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Without this, a checked segmented button and its unchecked neighbors
   were pixel-for-pixel identical -- confirmed by screenshot, no way to
   tell which of the three was actually selected. font-weight is a second,
   non-color cue riding along with the fill/text-color change. */
QPushButton#segLeft:checked, QPushButton#segMid:checked, QPushButton#segRight:checked {
    background-color: $ACCENT;
    border-color: $ACCENT;
    color: $TEXT_ON_ACCENT;
    font-weight: 600;
}

QPushButton#segLeft:checked:hover, QPushButton#segMid:checked:hover, QPushButton#segRight:checked:hover {
    background-color: $ACCENT_HOVER;
}

QComboBox, QLineEdit, QSpinBox, QPlainTextEdit {
    background-color: $BG_FIELD;
    border: 1px solid $BORDER;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: $ACCENT;
    selection-color: $TEXT_ON_ACCENT;
}

QComboBox:hover, QLineEdit:hover, QSpinBox:hover {
    border-color: $BORDER_HOVER;
}

QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QPlainTextEdit:focus {
    border-color: $ACCENT;
}

/* Buttons/checkboxes/sliders/the queue table/tabs had no focus indicator
   of their own at all before this -- confirmed by screenshot, Tab-ing to
   any of them showed no visible change whatsoever. Not just a style
   preference: keyboard-only navigation needs to be able to see where
   focus actually is, on every focusable control, not just text fields.
   outline, not border-color like the fields above -- it draws outside
   the widget's own box without changing its layout size, which matters
   here since several of these (the segmented Rate Control buttons,
   sliders) already have exact-fit borders/radii a border-width change
   would visibly disrupt.

   [focusVisible="true"], not :focus -- QSS has no :focus-visible
   equivalent, and plain :focus matches a mouse click same as Tab,
   confirmed by screenshot: clicking a checkbox showed the exact same
   ring Tab-ing to it does, which is wrong the same way it would be in a
   browser without :focus-visible -- a pointer click doesn't need a
   keyboard-navigation aid. main.py's _FocusVisibleFilter watches
   FocusIn/FocusOut app-wide and mirrors QFocusEvent.reason() onto this
   property (true only for Tab/Backtab), so this rule now matches
   keyboard-acquired focus specifically. QTabBar::tab:focus is left as a
   real :focus below, unconverted -- a subcontrol isn't its own QObject,
   so it can't carry this dynamic property itself the way a QWidget can. */
QPushButton[focusVisible="true"], QCheckBox[focusVisible="true"],
QSlider[focusVisible="true"], QTreeWidget[focusVisible="true"], QTabBar::tab:focus {
    outline: 2px solid $ACCENT;
    outline-offset: 1px;
}

/* An $ACCENT-colored ring is invisible on a button that's already
   $ACCENT-filled -- confirmed by screenshot: Tab-ing to the already-
   selected Quality button showed no visible focus change at all, while
   the same rule worked cleanly on every non-filled control. Start is
   always accent-filled while enabled; the segmented Rate Control buttons
   are accent-filled only while :checked. TEXT_ON_ACCENT is already the
   color this app picks for exactly this contrast problem elsewhere
   (button text sitting on an accent fill), so it's the right choice for
   the ring too, not a new color invented just for this. */
QPushButton#startButton[focusVisible="true"],
QPushButton#segLeft:checked[focusVisible="true"],
QPushButton#segMid:checked[focusVisible="true"],
QPushButton#segRight:checked[focusVisible="true"] {
    outline-color: $TEXT_ON_ACCENT;
}

/* Preset row's "you've changed something since loading this preset"
   indicator -- recolors the combo's own text rather than a separate
   "(modified)" label next to it, which took/gave back layout space every
   time it appeared or disappeared and visibly reflowed the whole window
   (confirmed by screenshot). main.py's _update_preset_modified_indicator
   sets this property and re-polishes the widget so Qt re-evaluates it --
   a dynamic property change alone doesn't trigger a QSS re-match. */
QComboBox[modified="true"] {
    color: $ACCENT;
    font-weight: 600;
    font-style: italic;
}

/* Without these, the up/down buttons inherit QSpinBox's own field
   background with no border between them and the text, and Fusion's
   default arrow glyph color (from the palette, never set to a theme-aware
   variant since this app has no QPalette of its own, only this stylesheet)
   can end up all but invisible against that background -- confirmed by
   screenshot in the dark theme originally: the buttons were there and
   clickable, just effectively invisible. */
QSpinBox::up-button, QSpinBox::down-button {
    background-color: $BG_CONTROL;
    width: 18px;
    border-left: 1px solid $BORDER;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: $BG_CONTROL_HOVER;
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background-color: $BG_CONTROL_PRESSED;
}

QSpinBox::up-arrow {
    image: url($ARROW_UP_ICON);
    width: 10px;
    height: 6px;
}

QSpinBox::down-arrow {
    image: url($ARROW_DOWN_ICON);
    width: 10px;
    height: 6px;
}

/* Styling ::drop-down at all suppresses Fusion's own native button paint
   underneath -- previously left alone deliberately for that reason, but
   Fusion's native button (a raised/bordered grey box) doesn't match this
   theme's flat language at all once everything around it is themed --
   confirmed by screenshot, it stood out as generic/un-themed next to every
   other flat control. A themed flat button + $ARROW_DOWN_ICON (the same
   glyph QSpinBox already uses) replaces it instead of just disabling it,
   so the "this is a dropdown" affordance doesn't disappear either. */
QComboBox::drop-down {
    background-color: $BG_CONTROL;
    border-left: 1px solid $BORDER;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    width: 22px;
}

QComboBox::drop-down:hover {
    background-color: $BG_CONTROL_HOVER;
}

QComboBox::down-arrow {
    image: url($ARROW_DOWN_ICON);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: $BG_PANEL;
    border: 1px solid $BORDER;
    outline: none;
    selection-background-color: $ACCENT;
    selection-color: $TEXT_ON_ACCENT;
}

/* A combobox's popup list isn't just the QAbstractItemView styled above --
   Qt wraps it in its own QFrame, and that QFrame *is* the popup's actual
   top-level window (confirmed directly: view.window() is the same QFrame
   instance as view.parentWidget()), not a nested child the way every
   other plain QWidget in this app is. The transparent-by-default QWidget
   rule near the top of this file is exactly right for a nested child
   (show whatever's already opaquely painted behind it) but wrong for a
   genuinely top-level popup window, which has nothing behind it to show
   through to.

   This rule alone does NOT fix that popup, despite being exactly the fix
   it looks like -- confirmed by a real screen capture (QWidget.grab() is
   not trustworthy for this, see below) that the black bars survive with
   this rule loaded and live. The popup frame is Qt's internal
   QComboBoxPrivateContainer, and for reasons that didn't turn up
   inspecting the widget directly (autoFillBackground is False, frameShape
   is NoFrame -- it's meant to rely entirely on the QSS engine), it
   doesn't repaint from this app-wide cascade the way the QListView nested
   inside it does. The actual fix is main.py's
   _ComboPopupBackgroundFilter, which sets a stylesheet directly on that
   frame at Show time instead of trusting the cascade to reach it -- a
   direct per-instance assignment was confirmed by another real capture to
   paint correctly where this rule alone didn't.

   Left in place anyway: it's the correct declared intent for any genuine
   QFrame content, harmless alongside the Python-side fix, and QWidget.grab()
   -based verification earlier in this app's history had wrongly suggested
   this rule alone was sufficient -- worth being honest in-place about that
   rather than deleting the evidence of the wrong turn. */
QFrame {
    background-color: $BG_PANEL;
    border: none;
}

/* Same root cause, same fix, a third widget type this time: QMessageBox
   (Clear Queue's confirmation, Delete Preset's, Overwrite?'s) is a
   genuinely top-level window too (QMessageBox -> QDialog -> QWidget,
   confirmed via issubclass() -- QDialog is never a nested child the way
   the rest of this app's plain QWidgets are), so it fell through to the
   same transparent default and rendered with a solid black body --
   reported directly, this one isn't reproducible under the offscreen
   platform's fake compositing any more than the combobox popup was.
   QInputDialog (Save Preset) and QFileDialog (Add Files/Change output
   folder, though the latter may use the native OS picker instead of
   Qt's own) are QDialog subclasses too, confirmed the same way, so this
   targets QDialog itself rather than QMessageBox alone -- confirmed
   first that nothing already styled elsewhere in this file is secretly
   a QDialog too, so this can't clobber an existing rule the way the
   QFrame/QLabel overlap could have. */
QDialog {
    background-color: $BG_PANEL;
}

/* QLabel is, perhaps surprisingly, a QFrame subclass too (confirmed via
   issubclass(), not assumed) -- without this override, every label in the
   app would just have picked up the rule above's $BG_PANEL fill instead
   of the transparent background it actually needs (see the QWidget
   default's own comment for why: showing whatever's really behind it,
   $BG_WINDOW or $BG_PANEL depending where it's nested, rather than
   opaquely painting one fixed color regardless). More specific than
   QFrame for an actual QLabel instance, so this wins regardless of which
   rule appears first in the file. */
QLabel {
    background-color: transparent;
}

QLineEdit:read-only {
    color: $TEXT_READONLY;
}

QSlider {
    min-height: 26px;
}

/* Groups a slider row with its fuzzy tier caption directly underneath --
   Quality+its caption, Speed+its caption (main.py: #fuzzyGroup on the
   QWidget wrapping each pair). Without this they were just two
   consecutive, visually independent form rows with nothing showing the
   caption actually describes the specific slider above it rather than
   being some unrelated adjacent line. */
QWidget#fuzzyGroup {
    border: 1px solid $BORDER;
    border-radius: 6px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: $BORDER;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: $ACCENT;
    border-radius: 2px;
}

/* Handle fill is $ACCENT, not $TEXT_PRIMARY -- TEXT_PRIMARY is near-white
   in Dark (reads fine there) but near-black in Light, which rendered as a
   heavy black dot the accent-blue groove/sub-page gave no visual reason to
   expect -- confirmed by screenshot in Light specifically, not assumed
   from the token values alone. */
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background: $ACCENT;
    border: 2px solid $BG_PANEL;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: $ACCENT_HOVER;
}

QProgressBar {
    background: $BG_FIELD;
    border: 1px solid $BORDER;
    border-radius: 6px;
    min-height: 18px;
    text-align: center;
    color: $TEXT_PRIMARY;
}

QProgressBar::chunk {
    background-color: $ACCENT;
    border-radius: 5px;
}

QTreeWidget {
    background-color: $BG_FIELD;
    border: 1px solid $BORDER;
    border-radius: 8px;
    padding: 4px;
    alternate-background-color: $BG_PANEL;
}

QTreeWidget::item {
    padding: 5px 6px;
    border-bottom: 1px solid $BORDER;
}

QTreeWidget::item:selected {
    background-color: $SELECTION_BG;
    color: $TEXT_PRIMARY;
}

QTreeWidget::item:hover:!selected {
    background-color: $HOVER_BG;
}

QTreeWidget::branch {
    border: none;
}

QHeaderView::section {
    background-color: $BG_PANEL;
    color: $TEXT_SECONDARY;
    padding: 5px 6px;
    border: none;
    border-right: 1px solid $BORDER;
    border-bottom: 1px solid $BORDER_STRONG;
    font-weight: 600;
}

QHeaderView::section:last {
    border-right: none;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid $BORDER_HOVER;
    border-radius: 4px;
    background: $BG_FIELD;
}

QCheckBox::indicator:checked {
    background: $ACCENT;
    border-color: $ACCENT;
    /* Touching ::indicator at all (even just for the unchecked base look)
       stops Fusion drawing its own native checkmark glyph on top -- same
       reason ::drop-down is left alone for QComboBox above. Verified by
       screenshot: without this image, :checked and :unchecked render as
       two identically-shaped boxes that differ only by fill color, with
       nothing to instantly read as "checked" at a glance. */
    image: url($CHECK_ICON);
}

QCheckBox::indicator:hover {
    border-color: $ACCENT;
}

QSplitter::handle {
    background: $SPLITTER;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: $BORDER_STRONG;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: $BORDER_HOVER;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: $BORDER_STRONG;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    background-color: $BG_CONTROL;
    color: $TEXT_PRIMARY;
    border: 1px solid $BORDER_HOVER;
    padding: 4px 6px;
}

/* The queue row right-click menu (Reveal Source/Output File) had no rule
   here at all, so it fell through to Fusion's own unstyled popup look --
   confirmed by real screenshot: a plain black surface, unreadable against
   this app's light theme (Dark happened to still read fine, coincidence
   of Fusion's own default being dark, not this app's palette). Same
   background/border/selection vocabulary as QComboBox QAbstractItemView
   above -- both are the same kind of floating popup-over-content surface. */
QMenu {
    background-color: $BG_PANEL;
    border: 1px solid $BORDER;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    color: $TEXT_PRIMARY;
}

QMenu::item:selected {
    background-color: $ACCENT;
    color: $TEXT_ON_ACCENT;
}

QMenu::item:disabled {
    color: $TEXT_DISABLED;
}

QMenu::separator {
    height: 1px;
    background: $BORDER;
    margin: 4px 8px;
}

/* Chrome (this footer strip) should read as a distinct layer from
   content, not blend into $BG_WINDOW the way it did before -- it had no
   background rule of its own at all. $BG_CONTROL (already used for
   buttons/toolbar-ish surfaces, not invented new just for this) plus a
   top border marks it off from the panels above cleanly in both themes. */
QStatusBar {
    background-color: $BG_CONTROL;
    border-top: 1px solid $BORDER;
}

QStatusBar::item {
    border: none;
}

